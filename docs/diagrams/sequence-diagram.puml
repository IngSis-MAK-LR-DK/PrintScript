@startuml PrintScript-Secuencia-Execution

actor Usuario
participant "Main" as Main
participant "CliArguments" as Args
participant "java.util.ServiceLoader" as SPI
participant "ModuloOperator\n(plugins:modulo-operator)" as Plugin
participant "ExecutionCommand" as Cmd
participant "Pipeline" as Pipeline
participant "Lexer\n(PrintScriptLexer)" as Lexer
participant "Parser\n(StatementIterator)" as StmtIter
participant "VersionValidator" as Version
participant "Interpreter\n(PrintScriptInterpreter)" as Interp
participant "StatementExecutor" as Exec
participant "InputProvider\n(StdInInputProvider)" as StdIn
participant "EnvironmentReader\n(SystemEnvironmentReader)" as EnvReader

Usuario -> Main: main(args)
activate Main

Main -> Args: parse(args)
Args --> Main: CliArguments\n(operation, file, version, config)

Main -> SPI: load(OperatorDefinition.class)
activate SPI
SPI -> Plugin: instancia (via META-INF/services)
note right of SPI
  Solo encuentra el plugin si el módulo
  está en el classpath (cli tiene una
  dependencia runtimeOnly, no de compilación)
end note
SPI --> Main: Set<OperatorDefinition>
deactivate SPI

Main -> Main: commandFor(arguments)\n(crea Lexer/Parser(operators, version), Pipeline,\nStdInInputProvider, SystemEnvironmentReader, Command)

Main -> Cmd: run(arguments)
activate Cmd

Cmd -> Pipeline: parse(sourceFile)
activate Pipeline
Pipeline -> Pipeline: new FilePositionalSource(file, reporter::reachedOffset)\n(lectura posicional, no un Reader secuencial)
Pipeline -> Lexer: tokenize(source)
Lexer --> Pipeline: TokenStream\n(el primer token ya está escaneado;\nel resto es perezoso vía tail())
Pipeline -> StmtIter: parse(tokens)\n(PrintScriptParser)
StmtIter --> Pipeline: Iterator<Statement>\n(envuelto por VersionValidator.validating(...))
Pipeline --> Cmd: Iterator<Statement> (con progreso;\ncierra FilePositionalSource al agotarse)
deactivate Pipeline

Cmd -> Cmd: new ExecutionContext(\n  System.out::println, stdInInputProvider, systemEnvironmentReader)
Cmd -> Interp: interpret(statements, context)
activate Interp

loop mientras statements.hasNext()
  Interp -> Version: statements.next()
  activate Version
  Version -> StmtIter: statements.next()
  activate StmtIter
  note right of StmtIter
    Arma el statement encadenando
    ParseResult<T> (nodo + TokenStream
    restante); pide más tokens al Lexer
    tirando de stream.tail() según hace
    falta, nunca todos de una.
  end note
  StmtIter -> Lexer: stream.tail() (una o más veces)
  activate Lexer
  note right of Lexer
    TokenScanner lee code points por
    offset (FilePositionalSource /
    StringPositionalSource) hasta
    completar UN token nuevo
  end note
  Lexer --> StmtIter: TokenStream (nuevo nodo)
  deactivate Lexer
  StmtIter --> Version: Statement
  deactivate StmtIter
  Version -> Version: statement.accept(this)\n(chequea la versión activa recién ahora,\nun statement a la vez - nunca antes de next())
  Version --> Interp: Statement
  deactivate Version

  Interp -> Exec: statement.accept(\n  new StatementExecutor(environment, context))
  activate Exec

  alt PrintlnStatement
    Exec -> "context.emitter()": emit(valor)
  else VariableDeclarationStatement / AssignmentStatement\ncon readInput(...) o readEnv(...)
    Exec -> StdIn: context.inputProvider().read(prompt)
    activate StdIn
    StdIn -> Usuario: imprime el prompt y lee una línea (Scanner)
    Usuario --> StdIn: línea tipeada
    StdIn --> Exec: String
    deactivate StdIn
    Exec -> EnvReader: context.environmentReader().read(nombre)
    activate EnvReader
    EnvReader --> Exec: Optional<String>\n(vacío -> SemanticException)
    deactivate EnvReader
    Exec -> Exec: coerce(raw, tipoDeclarado)\n(solo si la expresión ES DIRECTAMENTE\nel inicializador/valor - no si está anidada)
  else IfStatement
    Exec -> Exec: evalúa la condición (debe ser\nuna variable boolean) y ejecuta\nthenBranch o elseBranch recursivamente\n(mismo Environment, sin scoping propio)
  end

  Exec --> Interp: Environment (nuevo, inmutable)
  deactivate Exec
end

deactivate Interp
Cmd --> Main: exit code (0)
deactivate Cmd

Main -> Main: System.exit(code) si code != 0
deactivate Main

@enduml
